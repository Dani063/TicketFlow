diff --git a/PRO/Recordia/Manifests/TicketFlow.UI/pdb-web.yaml b/PRO/Recordia/Manifests/TicketFlow.UI/pdb-web.yaml
new file mode 100644
index 0000000..b85587f
--- /dev/null
+++ b/PRO/Recordia/Manifests/TicketFlow.UI/pdb-web.yaml
@@ -0,0 +1,17 @@
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: ticketflow-ui-web
+  namespace: recordia
+  annotations:
+    app.kubernetes.io/description: "Conservar al menos una web disponible durante retiradas voluntarias de nodos."
+    # Instalar la protección antes del Job de migración y del cambio de réplicas.
+    argocd.argoproj.io/sync-wave: "-2"
+  labels:
+    app: TicketFlow.UI.Web
+spec:
+  minAvailable: 1
+  selector:
+    matchLabels:
+      app: TicketFlow.UI.Web
+      role: web
