# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=ticketflow.example.com
CSRF_TRUSTED_ORIGINS=https://ticketflow.example.com

# ── Base de datos ────────────────────────────────────────────────────────────
# Opción A: credenciales directas (dev / sin SSM)
DB_ENGINE=django.db.backends.mysql
DB_NAME=ticketflow
DB_USER=ticketflow_user
DB_PASSWORD=change-me
DB_HOST=mysql-host
DB_PORT=3306

# Opción B: AWS SSM Parameter Store (producción recomendada)
# AWS_SSM_PREFIX=/Recordia/Production/Ticketflow
# AWS_REGION=eu-west-1

# ── Celery ───────────────────────────────────────────────────────────────────
# Producción: no definir CELERY_BROKER_URL → usa SQS automáticamente con IAM del pod
CELERY_SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/ACCOUNT_ID/ticketflow-celery
# Local dev con Redis: descomentar las dos líneas siguientes
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Azure AD — Microsoft Graph (buzones M365) ────────────────────────────────
# En producción todos vienen de AWS SSM (ver rutas abajo) — solo necesarios en local
AZURE_TENANT_ID=your-tenant-id        # SSM: .../AzureTenantId
AZURE_CLIENT_ID=your-client-id        # SSM: .../AzureClientId
AZURE_CLIENT_SECRET=your-client-secret # SSM: .../AzureClientSecret

# ── Azure OpenAI (clasificación IA de tickets) ───────────────────────────────
# En producción desde SSM: {AWS_SSM_PREFIX}/AzureOpenAICredentials (SecureString
# JSON con AZURE_OPENAI_ENDPOINT/API_KEY/DEPLOYMENT/API_VERSION). Opcional: sin
# credenciales la clasificación IA queda apagada automáticamente.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
# AI_CLASSIFICATION_ENABLED=true   # auto: on si hay endpoint+key
# AI_AUTO_APPLY=true               # false => solo sugerencias, nunca escribe en el ticket
# AI_AUTO_APPLY_CONFIDENCE=0.7
# AI_MAX_BODY_CHARS=6000

# ── Email saliente (SES + Graph) ─────────────────────────────────────────────
# SES autentica con el rol IAM del pod (ses:SendEmail sobre las identidades
# verificadas) — sin credenciales SMTP. M365 reutiliza AZURE_* (requiere el
# permiso de aplicación Mail.Send con admin consent).
OUTBOUND_EMAIL_ENABLED=false
AWS_SES_REGION=eu-west-1
# SES_CONFIGURATION_SET=ticketflow   # opcional: tracking de bounces/quejas
# Base para los enlaces {{ticket_url}} de las plantillas (sin barra final)
TICKETFLOW_PUBLIC_URL=https://ticketflow.example.com

# ── SSO ──────────────────────────────────────────────────────────────────────
SSO_LOGIN_API_URL=https://login-api.example.com
SSO_LOGIN_UI_URL=https://login.example.com
