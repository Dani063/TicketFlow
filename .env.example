# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=ticketflow.example.com
CSRF_TRUSTED_ORIGINS=https://ticketflow.example.com

# Logging. LOG_LEVEL aplica al codigo propio (DEBUG/INFO/WARNING/ERROR).
# LOG_FORMAT=json emite una linea JSON por registro, con el nivel como campo,
# para que el colector del cluster pueda filtrar por severidad. Es el valor por
# defecto; en local pon LOG_FORMAT=text para leerlo comodamente.
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Base de datos ────────────────────────────────────────────────────────────
# Opción A: credenciales directas (dev / sin SSM)
DB_ENGINE=django.db.backends.mysql
DB_NAME=ticketflow
DB_USER=ticketflow_user
DB_PASSWORD=change-me
DB_HOST=mysql-host
DB_PORT=3306

# Opción B: AWS SSM Parameter Store (producción recomendada)
# AWS_SSM_PREFIX=/Recordia/Production/Ticketflow
# AWS_REGION=eu-west-1

# ── Celery ───────────────────────────────────────────────────────────────────
# Producción: no definir CELERY_BROKER_URL → usa SQS automáticamente con IAM del pod
CELERY_SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/ACCOUNT_ID/ticketflow-celery
# Local dev con Redis: descomentar las dos líneas siguientes
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Azure AD — Microsoft Graph (buzones M365) ────────────────────────────────
# En producción todos vienen de AWS SSM (ver rutas abajo) — solo necesarios en local
AZURE_TENANT_ID=your-tenant-id        # SSM: .../AzureTenantId
AZURE_CLIENT_ID=your-client-id        # SSM: .../AzureClientId
AZURE_CLIENT_SECRET=your-client-secret # SSM: .../AzureClientSecret

# ── IA (clasificación de tickets + asistencia de respuesta) ──────────────────
# Proveedor en PRODUCCIÓN: OpenAI directo. La clave la lee el pod desde SSM en
# {AWS_SSM_PREFIX}/OpenAiToken (SecureString simple) con el rol IAM — no hace falta
# ponerla aquí en prod.
#
# LOCAL: define tu propia clave de OpenAI y SIEMPRE tiene precedencia sobre SSM
# (así desarrollas con tu cuota, desacoplado de prod). Es lo único necesario para
# que la IA funcione en local:
OPENAI_API_KEY=sk-tu-clave-de-desarrollo
# OPENAI_MODEL=gpt-4o-mini                 # por defecto gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # para casos similares
#
# Alternativa Azure OpenAI (heredada/opcional; solo si se aprovisiona el recurso).
# En prod vendría de SSM {AWS_SSM_PREFIX}/AzureOpenAICredentials (JSON).
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
#
# Flags (auto: on si hay credenciales por cualquiera de las vías anteriores):
# AI_CLASSIFICATION_ENABLED=true
# AI_REPLY_ASSIST_ENABLED=true
# AI_AUTO_APPLY=true               # false => solo sugerencias, nunca escribe en el ticket
# AI_AUTO_APPLY_CONFIDENCE=0.7
# AI_MAX_BODY_CHARS=6000

# ── Email saliente (SES + Graph) ─────────────────────────────────────────────
# SES autentica con el rol IAM del pod (ses:SendEmail sobre las identidades
# verificadas) — sin credenciales SMTP. M365 reutiliza AZURE_* (requiere el
# permiso de aplicación Mail.Send con admin consent).
OUTBOUND_EMAIL_ENABLED=false
AWS_SES_REGION=eu-west-1
# SES_CONFIGURATION_SET=ticketflow   # opcional: tracking de bounces/quejas
# Base para los enlaces {{ticket_url}} de las plantillas (sin barra final)
TICKETFLOW_PUBLIC_URL=https://ticketflow.example.com

# ── Centros de ayuda publicos ────────────────────────────────────────────────
PUBLIC_HELP_ENABLED=true
HELP_EDITOR_ENABLED=true
PUBLIC_TICKET_INTAKE_ENABLED=true
ECOMFAX_HELP_PUBLIC_URL=https://support.ecomfax.com
RECORDIA_HELP_PUBLIC_URL=https://support.recordia.net
PUBLIC_ECOMFAX_BRAND_NAME=eComFax
PUBLIC_RECORDIA_BRAND_NAME=Comunycarse Helpdesk
# Obligatorio en produccion con mas de una replica: bucket privado, no web.
# PUBLIC_ATTACHMENTS_S3_BUCKET=ticketflow-private-attachments
# PUBLIC_ATTACHMENTS_S3_REGION=eu-west-1
# Recursos privados del editor de artículos; si se omite, reutiliza el bucket anterior.
# HELP_CONTENT_S3_BUCKET=ticketflow-private-attachments
# HELP_CONTENT_S3_REGION=eu-west-1
HELP_CONTENT_ASSET_MAX_BYTES=20971520
# HELP_CONTENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,txt,csv,doc,docx,xls,xlsx,zip
PUBLIC_ATTACHMENT_MAX_FILES=5
PUBLIC_ATTACHMENT_MAX_BYTES=15728640
PUBLIC_TICKET_IP_LIMIT=5
PUBLIC_TICKET_IP_WINDOW_MINUTES=10
PUBLIC_TICKET_EMAIL_LIMIT=3
PUBLIC_TICKET_EMAIL_WINDOW_MINUTES=60
# Solo si el proxy de confianza sanea X-Forwarded-For:
# PUBLIC_CLIENT_IP_HEADER=HTTP_X_FORWARDED_FOR

# ── SSO ──────────────────────────────────────────────────────────────────────
SSO_LOGIN_API_URL=https://login-api.example.com
SSO_LOGIN_UI_URL=https://login.example.com
