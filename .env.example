# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=ticketflow.example.com
CSRF_TRUSTED_ORIGINS=https://ticketflow.example.com

# ── Base de datos ────────────────────────────────────────────────────────────
# Opción A: credenciales directas (dev / sin SSM)
DB_ENGINE=django.db.backends.mysql
DB_NAME=ticketflow
DB_USER=ticketflow_user
DB_PASSWORD=change-me
DB_HOST=mysql-host
DB_PORT=3306

# Opción B: AWS SSM Parameter Store (producción recomendada)
# AWS_SSM_PREFIX=/Recordia/Production/Ticketflow
# AWS_REGION=eu-west-1

# ── Celery / Redis ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Azure AD — Microsoft Graph (buzones M365) ────────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
# En producción viene de SSM: /Recordia/Development/Ticketflow/AzureClientSecret
AZURE_CLIENT_SECRET=your-client-secret

# ── SSO ──────────────────────────────────────────────────────────────────────
SSO_LOGIN_API_URL=https://login-api.example.com
SSO_LOGIN_UI_URL=https://login.example.com
